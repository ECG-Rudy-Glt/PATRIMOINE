{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patrimoine",
  "version": "0.1.0",
  "identifier": "org.patrimoine.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Patrimoine : application de bureau",
    "longDescription": "Fenêtre dédiée vers votre serveur Patrimoine auto-hébergé.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"] },
      "wix": { "language": ["fr-FR", "en-US"] }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
