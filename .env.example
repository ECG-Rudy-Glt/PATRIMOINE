# Patrimoine — configuration. Copiez en .env (ou lancez ./scripts/setup.sh qui génère les mots de passe).
# Rien de sensible ne doit être commité : .env et secrets/ sont ignorés par git.

# --- Base de données (généré par scripts/setup.sh) ---
POSTGRES_USER=patrimoine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=patrimoine
DATABASE_URL=postgresql://patrimoine:changeme@postgres:5432/patrimoine
LEDGER_URL=http://ledger:8000

# --- Grafana (tableau de bord technique) ---
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Banques : Enable Banking (API DSP2 officielles, accès restreint gratuit à ses propres comptes) ---
# Créez une application sur https://enablebanking.com/cp/ ; placez la clé privée dans secrets/enablebanking.pem
EB_APP_ID=
EB_PRIVATE_KEY=/secrets/enablebanking.pem
EB_SESSIONS_FILE=/secrets/sessions.json
EB_REDIRECT_URL=https://localhost/callback
EB_HISTORY_DAYS=90

# --- Powens (optionnel, désactivé par défaut) ---
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_USER_TOKEN=

# --- Notifications ntfy (optionnel) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Digest par e-mail (optionnel ; ex. Gmail : smtp.gmail.com, mot de passe d'application) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:8080

# --- Conseiller IA (optionnel). Aujourd'hui : API Claude (Anthropic). D'autres modèles sont prévus. ---
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-sonnet-5-5

# --- Marchés (optionnel) : twelvedata.com et fred.stlouisfed.org, gratuits ---
TWELVEDATA_API_KEY=
FRED_API_KEY=

# --- Home Assistant (optionnel) ---
# Webhook de poussée des chiffres ; vide = pas d'envoi
HA_WEBHOOK_URL=
# Webhook des alertes vers les notifications téléphone ; vide = pas d'envoi
HA_EVENTS_WEBHOOK_URL=
# Jeton de lecture seule de l'API /ha/ (openssl rand -hex 32) ; vide = API désactivée
HA_API_TOKEN=
# URL du tableau de bord dans Home Assistant (lien dans la barre latérale) ; vide = pas de lien
HA_DASHBOARD_URL=
